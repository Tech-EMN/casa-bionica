# Casa Biônica — Walking Skeleton
# Supabase Postgres

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_DB_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# MQTT Broker (Railway Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=casa_bionica

# App
APP_ENV=development
LOG_LEVEL=INFO
HOME_ID=home-001

# Secrets
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
